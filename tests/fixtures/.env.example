# App Configuration
APP_NAME=MyApp
APP_PORT=3000
APP_ENV=development

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
DATABASE_POOL_SIZE=10

# Authentication
JWT_SECRET=your-secret-here
JWT_EXPIRY=7d

# External APIs
STRIPE_SECRET_KEY=sk_test_xxxx
SENDGRID_API_KEY=SG.xxxx
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CACHE=true
